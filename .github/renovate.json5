{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: ['config:recommended'],
	dependencyDashboard: false,
	platformAutomerge: true,
	timezone: 'Europe/London',
	schedule: ['before 5am'],
	lockFileMaintenance: {
		enabled: true,
		schedule: ['before 3am on Monday'],
		automerge: true,
		automergeType: 'pr',
		automergeStrategy: 'squash',
	},
	nix: {
		enabled: true,
	},
	// GitHub Actions updates
	'github-actions': {
		enabled: true,
	},
	packageRules: [
		{
			matchManagers: ['nix'],
			matchPackageNames: ['nixpkgs'],
			schedule: ['every weekend'],
		},
		// GitHub Actions: never auto-merge. Workflows that push to main run these
		// actions, and main is deployed to the box as root, so a moved upstream tag
		// (a compromised action) must not reach main without a human look.
		// minimumReleaseAge only delays the PR; tag dates can be forged.
		{
			matchManagers: ['github-actions'],
			automerge: false,
			minimumReleaseAge: '7 days',
		},
		// Group flake.lock updates
		{
			matchManagers: ['nix'],
			matchFileNames: ['flake.lock', 'dev/flake.lock'],
			groupName: 'nix flake dependencies',
			schedule: ['before 3am on Sunday'],
			automerge: true,
			automergeType: 'pr',
			automergeStrategy: 'squash',
		},
	],
	prConcurrentLimit: 5,
	prHourlyLimit: 10,
	semanticCommits: 'enabled',
	commitMessagePrefix: 'chore(deps):',
	labels: ['dependencies'],
}
