# Push notifications via ntfy (https://ntfy.sh): the box reports problems to
# your phone instead of waiting for you to look.
#
#   - an upgrade was rejected or failed       (claude-box-upgrade)
#   - the Claude token stopped working         (claude-box-token-check, monthly)
#
# The topic name is the only credential, so it lives in sops (ntfy_topic,
# generated by bootstrap.sh). Subscribe to it in the ntfy app.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.box.notify;

  notify = pkgs.writeShellApplication {
    name = "claude-box-notify";
    runtimeInputs = [ pkgs.curl ];
    text = ''
      # usage: claude-box-notify <title> <message>
      curl -fsS --retry 5 --retry-all-errors --max-time 30 \
        -H "Title: $1" -H "Priority: high" -H "Tags: warning" \
        --data-binary "$2" \
        "${cfg.server}/$(< ${cfg.topicFile})" >/dev/null
    '';
  };

  tokenCheck = pkgs.writeShellApplication {
    name = "claude-box-token-check";
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      out=$(timeout 300 claude -p "Reply with exactly: token-ok" </dev/null 2>&1) || true
      if ! grep -q token-ok <<<"$out"; then
        echo "$out" | tail -20
        echo "Claude Code did not answer with the stored token." >&2
        exit 1
      fi
      echo "Token works."
    '';
  };
in
{
  options.box.notify = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = config.box.hasSecrets;
      description = "Send failure notifications via ntfy (needs ntfy_topic in secrets).";
    };
    topicFile = lib.mkOption {
      type = lib.types.str;
      default = config.sops.secrets.ntfy_topic.path;
      defaultText = "sops secret ntfy_topic";
      description = "File containing the ntfy topic name.";
    };
    server = lib.mkOption {
      type = lib.types.str;
      default = "https://ntfy.sh";
      description = "ntfy server; self-hosted instances work the same way.";
    };
  };

  config = lib.mkIf cfg.enable {
    sops.secrets.ntfy_topic = lib.mkIf config.box.hasSecrets { };

    environment.systemPackages = [ notify ];

    systemd = {
      # notify-failure@<unit>.service: sends the last log lines of <unit>.
      services = {
        "notify-failure@" = {
          description = "Notify about failure of %i";
          wants = [ "network-online.target" ];
          after = [ "network-online.target" ];
          serviceConfig.Type = "oneshot";
          scriptArgs = "%i";
          script = ''
            unit="$1"
            log=$(${config.systemd.package}/bin/journalctl -u "$unit" -n 15 --no-pager -o cat || true)
            ${lib.getExe notify} "claude-box: $unit failed" "$log"
          '';
        };

        claude-box-upgrade.onFailure = [ "notify-failure@%n.service" ];

        claude-box-token-check = {
          description = "Check that the stored Claude token still works";
          wants = [ "network-online.target" ];
          after = [ "network-online.target" ];
          onFailure = [ "notify-failure@%n.service" ];
          path = [ "/run/current-system/sw" ]; # the `claude` wrapper
          serviceConfig = {
            Type = "oneshot";
            User = "claude";
            ExecStart = lib.getExe tokenCheck;
          };
        };
      };
      timers.claude-box-token-check = {
        wantedBy = [ "timers.target" ];
        timerConfig = {
          OnCalendar = "monthly";
          RandomizedDelaySec = "6h";
          Persistent = true;
        };
      };
    };
  };
}
